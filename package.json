{
  "name": "@sinkplane/shared",
  "version": "0.1.1",
  "description": "Shared Floatplane API client, auth context, TV connection server, and React Query hooks for the Sinkplane apps",
  "packageManager": "pnpm@12.11.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sinkplane/sinkplane-shared.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "devDependencies": {
    "@preeternal/react-native-cookie-manager": "^7.0.0",
    "@tanstack/react-query": "^5.104.2",
    "@types/react": "~19.2.0",
    "@types/react-native-zeroconf": "^0.13.1",
    "expo": "~57.0.27",
    "expo-crypto": "~57.0.3",
    "expo-device": "~57.0.2",
    "expo-network": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "react": "19.2.3",
    "react-native": "npm:react-native-tvos@0.86.3-0",
    "react-native-tcp-socket": "^6.4.3",
    "react-native-zeroconf": "^0.17.4",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "@preeternal/react-native-cookie-manager": "^7.0.0",
    "@tanstack/react-query": "^5.104.2",
    "expo-crypto": "~57.0.3",
    "expo-device": "~57.0.2",
    "expo-network": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "react": "*",
    "react-native": "*",
    "react-native-tcp-socket": "^6.4.3",
    "react-native-zeroconf": "^0.17.4"
  }
}